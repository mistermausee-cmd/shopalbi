# Copy to .env and edit if you want to override defaults.
# All values shown are the defaults.

# --- Server / data source ---
SHOPALBI_API_HOST=https://europe.albion-online-data.com   # EU. West=Americas, East=Asia
SHOPALBI_TIERS=4,5,6,7,8

# --- Profit math ---
SHOPALBI_SALES_TAX=0.04            # Black Market sell tax. Premium=0.04, no premium=0.08
SHOPALBI_SETUP_FEE=0.025           # order setup fee (2.5% of the lot), deducted from the sale
SHOPALBI_FLIP_MAX_AGE_HOURS=12     # ignore prices older than this in the flip finder
SHOPALBI_MIN_PROFIT=1000           # default minimum profit (silver) for a flip to show
SHOPALBI_MIN_BM_DAILY_VOLUME=1     # BM must absorb at least this many units/day

# Cities excluded as buy sources (far / hard to reach Caerleon). Comma-separated.
SHOPALBI_EXCLUDED_BUY_CITIES=Brecilien

# --- Budget recommender ---
SHOPALBI_RECOMMEND_SLIPPAGE=0.10        # (fallback only) how fast avg buy price rises w/o live depth
SHOPALBI_RECOMMEND_VOLUME_CAPTURE=0.5   # (fallback only) share of a day's BM demand per item
SHOPALBI_RECOMMEND_NODEPTH_CAP=10       # max qty/item when there is NO live order-book depth yet

# --- Live order-book feed (AODP public NATS; no game client needed) ---
SHOPALBI_NATS_ENABLE=true
SHOPALBI_NATS_URL=nats://public:thenewalbiondata@nats.albion-online-data.com:34222  # EU (:4222 US, :24222 Asia)
SHOPALBI_NATS_TOPIC=marketorders.deduped
SHOPALBI_ORDER_MAX_AGE_MINUTES=30       # drop live orders older than this

# --- Refresh cadence ---
SHOPALBI_CURRENT_REFRESH_MINUTES=10
SHOPALBI_HISTORY_REFRESH_HOURS=12
SHOPALBI_HISTORY_DAYS=31
SHOPALBI_REFRESH_ON_START=true

# --- Web server ---
SHOPALBI_HOST=0.0.0.0
SHOPALBI_PORT=8000

# --- Optional HTTP Basic auth (empty = open site) ---
SHOPALBI_AUTH_USER=
SHOPALBI_AUTH_PASS=
