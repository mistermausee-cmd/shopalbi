# Copy to .env and edit if you want to override defaults.
# All values shown ARE the defaults.

# --- Server / data source ---
SHOPALBI_API_HOST=https://europe.albion-online-data.com   # EU. West=Americas, East=Asia
SHOPALBI_TIERS=4,5,6,7,8

# --- Taxes (verified against the Albion wiki Marketplace/Margin pages) ------
# SALES_TAX: charged when a sale completes. 0.04 with Premium, 0.08 without.
# SETUP_FEE: 2.5% charged only when you CREATE/UPDATE a market order.
#
# The default flip is instant on both legs (buy from an existing sell order,
# then "Sell" straight into a Black Market bid). Neither leg creates an order,
# so only the sales tax applies:  net = 1 - 0.04 = 0.96.
# Switch the modes below if you actually place orders instead.
SHOPALBI_SALES_TAX=0.04
SHOPALBI_SETUP_FEE=0.025
SHOPALBI_BUY_MODE=instant          # instant | order  (order = +2.5% on the buy)
SHOPALBI_SELL_MODE=instant         # instant | order  (order = -2.5% on the sale)

# --- Transport risk --------------------------------------------------------
# Chance of losing the WHOLE load on a Royal -> Caerleon run. Community figures
# put it at 5-15% in prime time. Expected value = (1-p)*revenue - cost.
# Buying inside Caerleon is risk-free (see CITY_RISK_MULTIPLIER in config.py).
SHOPALBI_GANK_RATE=0.08
SHOPALBI_LOAD_OVERHEAD_HOURS=0.35  # shopping time added to the ride, for profit/hour

# --- Filters / freshness ---------------------------------------------------
SHOPALBI_FLIP_MAX_AGE_HOURS=8      # ignore city prices older than this
SHOPALBI_BM_MAX_AGE_HOURS=3        # ignore Black Market bids older than this
SHOPALBI_MIN_PROFIT=1000           # default min profit (silver) per unit
SHOPALBI_MIN_PROFIT_PCT=0          # default min profit as % of cost
SHOPALBI_MIN_BM_DAILY_VOLUME=1     # BM must absorb at least this many units/day

# Cities excluded as buy sources. Brecilien is a Faerie Realm hub, not a Royal
# city, and is awkward to leave toward Caerleon.
SHOPALBI_EXCLUDED_BUY_CITIES=Brecilien

# --- Data sanity guards ----------------------------------------------------
# AODP is crowd-sourced, so single quotes can be junk (a 158-silver bid on a T5
# shield, a 499,999 troll sell order). Quotes are checked against the item's own
# volume-weighted history.
SHOPALBI_BM_MAX_VS_VWAP=2.2        # a bid above this x VWAP is flagged as a spike
SHOPALBI_BM_MIN_VS_VWAP=0.25       # ignore degenerate lowball bids
SHOPALBI_CITY_MAX_VS_VWAP=3.0      # ignore troll-priced city sell orders
SHOPALBI_DROP_SPIKED_BIDS=false    # true = hide spiked bids instead of flagging

# --- Liquidity scoring -----------------------------------------------------
# Log-scaled between these bounds. Real BM throughput spans four orders of
# magnitude (a niche T8 off-hand: single digits/day; T5_BAG: ~4,300/day).
SHOPALBI_LIQUIDITY_FLOOR=3
SHOPALBI_LIQUIDITY_REF=400

# --- Budget planner -------------------------------------------------------
SHOPALBI_RECOMMEND_NODEPTH_CAP=8       # max qty/item when there is NO live depth
SHOPALBI_RECOMMEND_VOLUME_CAPTURE=0.15 # ...also capped by this share of a day's BM demand
SHOPALBI_RECOMMEND_MAX_ITEM_SHARE=0.30 # no single item may eat more of the budget
SHOPALBI_RECOMMEND_MAX_ITEMS=40        # max positions in one shopping list

# --- Live order-book feed (AODP public NATS; no game client needed) --------
SHOPALBI_NATS_ENABLE=true
SHOPALBI_NATS_URL=nats://public:thenewalbiondata@nats.albion-online-data.com:34222  # EU (:4222 US, :24222 Asia)
# Never add marketorders.ingest: it duplicates orders and scales prices by 10000.
SHOPALBI_NATS_TOPICS=marketorders.deduped,marketorders.deduped.bulk
SHOPALBI_ORDER_MAX_AGE_MINUTES=360     # how long a live city order stays usable
SHOPALBI_BM_ORDER_MAX_AGE_MINUTES=90   # BM bids decay faster
SHOPALBI_NPC_EXPIRY_YEAR=2100          # Expires beyond this = system order (BM bid)

# --- Refresh cadence ------------------------------------------------------
SHOPALBI_CURRENT_REFRESH_MINUTES=10
SHOPALBI_HISTORY_REFRESH_HOURS=6
SHOPALBI_HISTORY_DAYS=31
SHOPALBI_REFRESH_ON_START=true

# --- Web server ----------------------------------------------------------
SHOPALBI_HOST=0.0.0.0
SHOPALBI_PORT=8000
SHOPALBI_LOG_DIR=/logs             # bind-mounted to /root/logs by docker-compose

# --- Optional HTTP Basic auth (empty = open site) ------------------------
SHOPALBI_AUTH_USER=
SHOPALBI_AUTH_PASS=
